<?xml version="1.0"?>
<body language="English">
	<row id="msg_0121_D38R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hey!\rI am the Karate King!\nI train alone here in the cave!\rYou!\nBattle with me! Hwaaarggh!\r</language>
	</row>
	<row id="msg_0121_D38R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I... I’m crushed...\rMy training is still not enough...\nBut a loss is a loss. I admit it.\rAs proof that you defeated me, I’ll give\nyou a rare Fighting-type Pokémon.\r</language>
	</row>
	<row id="msg_0121_D38R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} received TYROGUE from\nthe Karate King!</language>
	</row>
	<row id="msg_0121_D38R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TYROGUE is a Fighting type.\nIt evolves into a tougher Pokémon.\rKeep up the hard work. I’ll keep\ntraining too. Farewell!</language>
	</row>
	<row id="msg_0121_D38R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You have no room in your party!</language>
	</row>
	<row id="msg_0121_D38R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Give a nickname to the TYROGUE you\nreceived? {YESNO 0}</language>
	</row>
	<row id="msg_0121_D38R0104_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0121_D38R0104_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A {STRVAR_1 0, 2, 0} nature.\nIt fights with decent spirit!\r</language>
	</row>
	<row id="msg_0121_D38R0104_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A {STRVAR_1 0, 2, 0} nature.\nIt fights with above-average spirit!\r</language>
	</row>
	<row id="msg_0121_D38R0104_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A {STRVAR_1 0, 2, 0} nature.\nIt fights with relatively superior spirit!\r</language>
	</row>
	<row id="msg_0121_D38R0104_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A {STRVAR_1 0, 2, 0} nature.\nIt fights with outstanding spirit!!\r</language>
	</row>
	<row id="msg_0121_D38R0104_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Will you take it? {YESNO 0}</language>
	</row>
	<row id="msg_0121_D38R0104_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No? It’s eager to fight.\nLook again.\r</language>
	</row>
</body>
